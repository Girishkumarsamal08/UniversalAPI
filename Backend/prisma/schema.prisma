// Prisma Schema - Unified CRM API
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// USERS TABLE
// ─────────────────────────────────────────────
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("Developer")
  department   String   @default("Engineering")
  status       String   @default("APPROVED") // PENDING | APPROVED
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  ownedOrganizations Organization[] @relation("OrgOwner")
  memberships        OrgMember[]
  integrations       Integration[]
  apiLogs            ApiLog[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ORGANIZATIONS TABLE
// ─────────────────────────────────────────────
model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  owner     User        @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   OrgMember[]
  contacts  Contact[]
  companies Company[]
  deals     Deal[]
  projects  Project[]

  @@map("organizations")
}

// ─────────────────────────────────────────────
// ORG MEMBERS (Many-to-Many Users <-> Orgs)
// ─────────────────────────────────────────────
model OrgMember {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String   @default("member") // owner | admin | member
  joinedAt       DateTime @default(now()) @map("joined_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("org_members")
}

// ─────────────────────────────────────────────
// INTEGRATIONS TABLE (OAuth connections)
// ─────────────────────────────────────────────
model Integration {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  provider     String    // hubspot | salesforce | pipedrive
  status       String    @default("Not Connected") // Not Connected | Connecting | Connected | Syncing | Expired | Connection Failed
  accessToken  String    @map("access_token") @db.Text
  refreshToken String?   @map("refresh_token") @db.Text
  expiresAt    DateTime? @map("expires_at")
  connectedAt  DateTime  @default(now()) @map("connected_at")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("integrations")
}

// ─────────────────────────────────────────────
// DEALS TABLE
// ─────────────────────────────────────────────
model Deal {
  id             String   @id @default(uuid())
  externalId     String   @map("external_id")
  provider       String   // hubspot | salesforce | pipedrive | mock
  title          String
  amount         Float?
  stage          String?
  organizationId String   @map("organization_id")
  rawData        Json?    @map("raw_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([externalId, provider, organizationId])
  @@map("deals")
}

// ─────────────────────────────────────────────
// CONTACTS TABLE
// ─────────────────────────────────────────────
model Contact {
  id             String  @id @default(uuid())
  externalId     String  @map("external_id")
  provider       String  // hubspot | salesforce | pipedrive | mock
  name           String
  email          String?
  phone          String?
  jobTitle       String? @map("job_title")
  organizationId String  @map("organization_id")
  rawData        Json?   @map("raw_data") // original provider payload
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([externalId, provider, organizationId])
  @@map("contacts")
}

// ─────────────────────────────────────────────
// COMPANIES TABLE
// ─────────────────────────────────────────────
model Company {
  id             String  @id @default(uuid())
  externalId     String  @map("external_id")
  provider       String  // hubspot | salesforce | pipedrive | mock
  name           String
  website        String?
  industry       String?
  size           String?
  organizationId String  @map("organization_id")
  rawData        Json?   @map("raw_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([externalId, provider, organizationId])
  @@map("companies")
}

// ─────────────────────────────────────────────
// API LOGS TABLE
// ─────────────────────────────────────────────
model ApiLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  endpoint     String
  method       String
  statusCode   Int      @map("status_code")
  responseTime Int      @map("response_time") // milliseconds
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  errorMessage String?  @map("error_message") @db.Text
  timestamp    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([endpoint])
  @@index([timestamp])
  @@map("api_logs")
}

// ─────────────────────────────────────────────
// REFRESH TOKENS TABLE
// ─────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// PROJECTS TABLE
// ─────────────────────────────────────────────
model Project {
  id             String              @id @default(uuid())
  name           String
  description    String?
  organizationId String              @map("organization_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    ProjectAssignment[]

  @@map("projects")
}

model ProjectAssignment {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_assignments")
}

// ─────────────────────────────────────────────
// APPROVAL REQUESTS TABLE
// ─────────────────────────────────────────────
model ApprovalRequest {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id") // requester
  action         String    // ADD_INTEGRATION | DELETE_API | ROTATE_CREDENTIALS | APPROVE_USER
  targetId       String?   @map("target_id")
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedAt    DateTime  @default(now()) @map("requested_at")
  resolvedAt     DateTime? @map("resolved_at")
  resolvedById   String?   @map("resolved_by_id")

  @@map("approval_requests")
}
